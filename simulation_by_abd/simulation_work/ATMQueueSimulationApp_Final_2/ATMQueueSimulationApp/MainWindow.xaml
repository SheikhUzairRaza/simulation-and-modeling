<Window x:Class="ATMQueueSimulationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATM Queue Simulation System — HBL ATM, Lucky One Mall (2nd Floor Food Court)"
        Height="820" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Window.Resources />

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <!-- Header / title bar -->
            <RowDefinition Height="*" />
            <!-- Main content -->
            <RowDefinition Height="230" />
            <!-- Comparison table -->
            <RowDefinition Height="28" />
            <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ===================== HEADER ===================== -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="🏧" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="ATM Queue Simulation System" Foreground="White" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="Case Study: HBL ATM — Lucky One Mall, 2nd Floor Food Court" Foreground="#C7D3E0" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="ClockText" Grid.Column="1" Foreground="#C7D3E0" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,18,0" Text="Modeling &amp; Simulation — Final Year Project" />
            </Grid>
        </Border>

        <!-- ===================== MAIN CONTENT ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <!-- Left: inputs -->
                <ColumnDefinition Width="*" />
                <!-- Center: results + log -->
                <ColumnDefinition Width="420" />
                <!-- Right: charts -->
            </Grid.ColumnDefinitions>

            <!-- ===================== LEFT PANEL ===================== -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Simulation Setup" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,10" />

                        <TextBlock Text="Queueing Model" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ModelComboBox" SelectedIndex="0">
                            <ComboBoxItem Content="M/M/1" />
                            <ComboBoxItem Content="M/M/s" />
                            <ComboBoxItem Content="M/G/1" />
                            <ComboBoxItem Content="M/G/s" />
                            <ComboBoxItem Content="G/G/1" />
                            <ComboBoxItem Content="G/G/s" />
                        </ComboBox>

                        <TextBlock Text="Dataset Source" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <RadioButton x:Name="DefaultDatasetRadio" Content="Default ATM Dataset"
                                         GroupName="DatasetSource" IsChecked="True" Margin="0,0,14,0" />
                            <RadioButton x:Name="CustomDatasetRadio" Content="Custom Inputs"
                                         GroupName="DatasetSource" />
                        </StackPanel>

                        <TextBlock Text="Arrival Rate  λ  (customers/min)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ArrivalRateTextBox" Text="0.40" />

                        <TextBlock Text="Service Rate  μ  (customers/min)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ServiceRateTextBox" Text="0.55" />

                        <TextBlock x:Name="ArrivalStdDevLabel" Text="Arrival Time Std Dev  σₐ  (min)"
                                   Style="{StaticResource FieldLabel}" Visibility="Collapsed" />
                        <TextBox x:Name="ArrivalStdDevTextBox" Text="0.50" Visibility="Collapsed" />

                        <TextBlock x:Name="ServiceStdDevLabel" Text="Service Time Std Dev  σₛ  (min)"
                                   Style="{StaticResource FieldLabel}" Visibility="Collapsed" />
                        <TextBox x:Name="ServiceStdDevTextBox" Text="0.50" Visibility="Collapsed" />

                        <TextBlock Text="Number of Servers (s)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ServersTextBox" Text="1" />

                        <TextBlock Text="Number of Customers" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CustomersTextBox" Text="120" />

                        <TextBlock Text="Simulation Time (minutes, optional)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SimTimeTextBox" Text="480" />

                        <Separator Margin="0,14,0,4" />

                        <Button x:Name="RunSimulationButton" Content="▶  Run Simulation" Style="{StaticResource PrimaryButton}" />
                        <Button x:Name="CompareAllButton" Content="⇄  Compare All Models" Style="{StaticResource SecondaryButton}" />
                        <Button x:Name="GenerateRandomDatasetButton" Content="🎲  Generate Random Dataset" Style="{StaticResource SecondaryButton}" />
                        <Button x:Name="ResetButton" Content="⟲  Reset" Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===================== CENTER: RESULTS + LOG ===================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- KPI Results grid -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Simulation Results" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8" />
                        <UniformGrid x:Name="ResultsGrid" Columns="4" Rows="3">
                            <!-- Each KPI cell -->
                            <StackPanel Margin="4">
                                <TextBlock Text="Avg Waiting Time" Style="{StaticResource KpiLabelText}" />
                                <TextBlock x:Name="AvgWaitingTimeText" Text="—" Style="{StaticResource KpiValueText}" />
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Avg Service Time" Style="{StaticResource KpiLabelText}" />
                                <TextBlock x:Name="AvgServiceTimeText" Text="—" Style="{StaticResource KpiValueText}" />
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Avg Turnaround Time" Style="{StaticResource KpiLabelText}" />
                                <TextBlock x:Name="AvgTurnaroundTimeText" Text="—" Style="{StaticResource KpiValueText}" />
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Avg Queue Length" Style="{StaticResource KpiLabelText}" />
                                <TextBlock x:Name="AvgQueueLengthText" Text="—" Style="{StaticResource KpiValueText}" />
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Max Queue Length" Style="{StaticResource KpiLabelText}" />
                                <TextBlock x:Name="MaxQueueLengthText" Text="—" Style="{StaticResource KpiValueText}" />
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Server Utilization" Style="{StaticResource KpiLabelText}" />
                                <TextBlock x:Name="UtilizationText" Text="—" Style="{StaticResource KpiValueText}" />
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Idle Time" Style="{StaticResource KpiLabelText}" />
                                <TextBlock x:Name="IdleTimeText" Text="—" Style="{StaticResource KpiValueText}" />
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Probability of Waiting" Style="{StaticResource KpiLabelText}" />
                                <TextBlock x:Name="ProbWaitingText" Text="—" Style="{StaticResource KpiValueText}" />
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Throughput" Style="{StaticResource KpiLabelText}" />
                                <TextBlock x:Name="ThroughputText" Text="—" Style="{StaticResource KpiValueText}" />
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Customers Served" Style="{StaticResource KpiLabelText}" />
                                <TextBlock x:Name="CustomersServedText" Text="—" Style="{StaticResource KpiValueText}" />
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Total Simulation Time" Style="{StaticResource KpiLabelText}" />
                                <TextBlock x:Name="TotalSimTimeText" Text="—" Style="{StaticResource KpiValueText}" />
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Active Model" Style="{StaticResource KpiLabelText}" />
                                <TextBlock x:Name="ActiveModelText" Text="—" Style="{StaticResource KpiValueText}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Simulation log -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Simulation Log" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8" />
                        <ListBox x:Name="SimulationLogListBox" FontFamily="Consolas" FontSize="11"
                                 Background="#0F172A" Foreground="#D1E8FF" BorderThickness="0" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===================== RIGHT PANEL: CHARTS ===================== -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Charts" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8" />
                    <TabControl x:Name="ChartsTabControl">
                        <TabItem Header="Queue Length">
                            <Border x:Name="QueueLengthChartHost" Background="White" />
                        </TabItem>
                        <TabItem Header="Waiting Time Histogram">
                            <Border x:Name="WaitingTimeHistogramHost" Background="White" />
                        </TabItem>
                        <TabItem Header="Server Utilization">
                            <Border x:Name="UtilizationChartHost" Background="White" />
                        </TabItem>
                        <TabItem Header="Turnaround Distribution">
                            <Border x:Name="TurnaroundChartHost" Background="White" />
                        </TabItem>
                        <TabItem Header="Gantt Chart">
                            <Border x:Name="GanttChartHost" Background="White" />
                        </TabItem>
                        <TabItem Header="Model Comparison">
                            <Border x:Name="ComparisonChartHost" Background="White" />
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===================== COMPARISON TABLE ===================== -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Model Comparison" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8" />
                <DataGrid x:Name="ComparisonDataGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Model" Binding="{Binding ModelName}" Width="90" />
                        <DataGridTextColumn Header="Avg Waiting Time" Binding="{Binding AvgWaitingTime}" Width="*" />
                        <DataGridTextColumn Header="Avg Queue Length" Binding="{Binding AvgQueueLength}" Width="*" />
                        <DataGridTextColumn Header="Avg Turnaround Time" Binding="{Binding AvgTurnaroundTime}" Width="*" />
                        <DataGridTextColumn Header="Utilization" Binding="{Binding Utilization}" Width="*" />
                        <DataGridTextColumn Header="Throughput" Binding="{Binding Throughput}" Width="*" />
                        <DataGridTextColumn Header="Idle Time" Binding="{Binding IdleTime}" Width="*" />
                        <DataGridTextColumn Header="Customers Served" Binding="{Binding CustomersServed}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ===================== STATUS BAR ===================== -->
        <Border Grid.Row="3" Background="{StaticResource PrimaryDarkBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready." Foreground="#C7D3E0" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock Grid.Column="1" Text="BS Software Engineering — Modeling &amp; Simulation" Foreground="#8FA3BC" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
