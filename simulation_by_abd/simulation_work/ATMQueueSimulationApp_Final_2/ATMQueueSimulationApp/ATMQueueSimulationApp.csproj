<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ATMQueueSimulationApp</RootNamespace>
    <AssemblyName>ATMQueueSimulationApp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Charting library for WPF (LiveCharts2). SkiaSharp.Views.WPF is pulled in
         automatically as a transitive dependency - do not pin it separately, doing
         so can force NuGet to pick a mismatched version. -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc5.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ensure the dataset CSV is copied to the output folder when the app builds -->
    <None Update="Data\atm_dataset.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
